# Claude reviews the architecture and writes the tailored roadmap. Without it, Flo uses its rule-based planner.
ANTHROPIC_API_KEY=
# Public URL of this deployment, used for canonical links, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Google Analytics 4 measurement ID (G-XXXXXXX).
NEXT_PUBLIC_GA_ID=
# Where reports and enquiries are stored (JSON files). Defaults to ./.flo-data
FLO_DATA_DIR=
# Optional Cloudflare Turnstile keys. When set, scans and enquiries need a (usually invisible) human check,
# so bots can't use Flo as a free scanning API.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
