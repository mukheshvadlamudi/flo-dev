{
  "name": "flo",
  "version": "0.1.0",
  "description": "Production-readiness audits for vibe-coded apps: security scan, bug hunt, architecture review and a step-by-step plan to ship.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "flo": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "tsx src/cli.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
